# ---- Database (PostgreSQL — Neon recommended) ----
# DATABASE_URL — Neon POOLED connection string.
#   Used by Prisma Client / the Next.js app at runtime (e.g. on Vercel).
#   Copy the "-pooler" connection string from your Neon dashboard.
DATABASE_URL="postgresql://user:password@pooler-host.neon.tech/database?sslmode=require"

# DIRECT_URL — Neon DIRECT (non-pooled) connection string.
#   Used by the Prisma CLI for migrations and administrative operations.
#   Copy the regular (non-pooled) connection string from your Neon dashboard.
DIRECT_URL="postgresql://user:password@direct-host.neon.tech/database?sslmode=require"

# Local development: point both at the same local Postgres, e.g.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contentforge"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/contentforge"

# ---- AI Provider ----
# One of: openai | anthropic | mock
#  - openai    → uses OPENAI_API_KEY (any OpenAI-compatible endpoint via OPENAI_BASE_URL)
#  - anthropic → uses ANTHROPIC_API_KEY
#  - mock      → offline template provider for dev/CI (no key needed)
# If AI_PROVIDER is empty, the app auto-detects from whichever key is present.
AI_PROVIDER="openai"

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
# Optional: point the OpenAI client at a compatible gateway
# OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
# Optional:
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
