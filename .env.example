# ---- Database ----
# Local: any MySQL/MariaDB or PostgreSQL URL Prisma accepts.
# Production (recommended): Postgres from Neon / Supabase / Railway, e.g.
#   postgresql://user:password@host:5432/contentforge?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/contentforge?schema=public"

# ---- AI Provider ----
# One of: openai | anthropic | mock
#  - openai    → uses OPENAI_API_KEY (any OpenAI-compatible endpoint via OPENAI_BASE_URL)
#  - anthropic → uses ANTHROPIC_API_KEY
#  - mock      → offline template provider for dev/CI (no key needed)
# If AI_PROVIDER is empty, the app auto-detects from whichever key is present.
AI_PROVIDER="openai"

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
# Optional: point the OpenAI client at a compatible gateway
# OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
# Optional:
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
